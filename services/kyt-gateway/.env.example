HOST=127.0.0.1
PORT=3200

# Only Bonanza Factory-operated HTTPS endpoints are accepted by the client.
TRANSIGHT_API_BASE_URL=https://t-api.transight.io
TRANSIGHT_OAUTH_TOKEN_URL=https://t-api.transight.io/oauth/token
TRANSIGHT_OAUTH_CLIENT_ID=
TRANSIGHT_OAUTH_CLIENT_SECRET=
TRANSIGHT_OAUTH_SCOPE=ORG_CLIENT

# Provider-issued 32-byte key and 16-byte IV. The current v2.0 examples send
# JSON over TLS; these values are validated and the codec is covered by tests,
# but an undocumented encrypted envelope is never guessed.
TRANSIGHT_ENCRYPTION_KEY=
TRANSIGHT_ENCRYPTION_IV=
TRANSIGHT_PAYLOAD_ENCRYPTION_MODE=documented-json

TRANSIGHT_TIMEOUT_MS=8000
TRANSIGHT_TOKEN_REFRESH_AHEAD_MS=300000
TRANSIGHT_TPS_LIMIT=8

# Independent server-to-server credential used by the WSS Edge Function.
INTERNAL_GATEWAY_TOKEN=
