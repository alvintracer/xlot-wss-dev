{"artifact_version":1,"noir_version":"1.0.0-rc.5+0f759ffe9176ffbbe7f67b159ac2c3202e0748a0","hash":"2556153608","abi":{"abi_version":1,"parameters":[{"name":"name_hash","type":{"kind":"array","length":32,"type":{"kind":"integer","sign":"unsigned","width":8}},"visibility":"private"},{"name":"birth_date","type":{"kind":"array","length":10,"type":{"kind":"integer","sign":"unsigned","width":8}},"visibility":"private"},{"name":"salt","type":{"kind":"array","length":32,"type":{"kind":"integer","sign":"unsigned","width":8}},"visibility":"private"},{"name":"expected_claim_digest","type":{"kind":"array","length":32,"type":{"kind":"integer","sign":"unsigned","width":8}},"visibility":"public"},{"name":"commitment","type":{"kind":"array","length":32,"type":{"kind":"integer","sign":"unsigned","width":8}},"visibility":"public"},{"name":"challenge","type":{"kind":"array","length":16,"type":{"kind":"integer","sign":"unsigned","width":8}},"visibility":"public"}],"return_type":{"abi_type":{"kind":"array","length":32,"type":{"kind":"integer","sign":"unsigned","width":8}},"visibility":"public"},"error_types":{}},"bytecode":"","debug_symbols":"","file_map":{"53":{"source":"use std::hash::blake2s;\n\n// Prove the issuer-signed commitment opens to the requested name digest and\n// birth date. The holder's 256-bit salt never becomes a public input.\nfn main(\n    name_hash: [u8; 32],\n    birth_date: [u8; 10],\n    salt: [u8; 32],\n    expected_claim_digest: pub [u8; 32],\n    commitment: pub [u8; 32],\n    challenge: pub [u8; 16],\n) -> pub [u8; 32] {\n    let mut claim = [0; 75];\n    claim[0] = 1;\n    for i in 0..32 { claim[i + 1] = name_hash[i]; }\n    for i in 0..10 {\n        claim[i + 33] = birth_date[i];\n    }\n    for i in 0..32 {\n        claim[i + 43] = salt[i];\n    }\n    let digest = blake2s(claim);\n    let mut expected = [0; 59];\n    expected[0] = 3;\n    for i in 0..32 { expected[i + 1] = name_hash[i]; }\n    for i in 0..10 { expected[i + 33] = birth_date[i]; }\n    for i in 0..16 { expected[i + 43] = challenge[i]; }\n    let expected_digest = blake2s(expected);\n    for i in 0..32 { assert(expected_digest[i] == expected_claim_digest[i]); }\n    let mut binding = [0; 49];\n    binding[0] = 2;\n    for i in 0..32 {\n        assert(digest[i] == commitment[i]);\n        binding[i + 1] = digest[i];\n    }\n    for i in 0..16 {\n        binding[i + 33] = challenge[i];\n    }\n    blake2s(binding)\n}\n","path":"circuit/src/main.nr","function_locations":[{"start":371,"name":"main"}]}}}