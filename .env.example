# Local development only. Production must provide independently generated secrets.
WSS_SESSION_SECRET=replace-with-at-least-32-random-characters
WSS_SUBJECT_HASH_SECRET=replace-with-a-different-stable-32-character-secret
WSS_INSTITUTION_API_KEY=replace-with-an-institution-server-secret
WSS_DEPLOYMENT_MODE=local-development
WSS_PREVIEW_ACCESS_CODE=replace-with-a-private-preview-access-code
WSS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
VITE_WSS_BFF_URL=http://localhost:4100
VITE_WSS_WALLET_URL=http://localhost:5174
VITE_WSS_ALLOWED_HOST_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_WSS_ALLOWED_BFF_ORIGINS=http://localhost:4100,http://127.0.0.1:4100

# Isolated WSS development database. Never point this at took/XLOT B2C or production.
SUPABASE_URL=https://your-wss-dev-project.supabase.co
SUPABASE_ANON_KEY=replace-with-wss-dev-publishable-key
DATABASE_URL=postgresql://server-only-wss-role:password@host:5432/postgres
WSS_PII_ENCRYPTION_KEY=replace-with-64-hex-characters
WSS_SAR_V2_PHONE_SHARE_KEY=replace-with-independent-64-hex-characters
WSS_SAR_V2_EMAIL_SHARE_KEY=replace-with-another-independent-64-hex-characters
WSS_PHONE_LOOKUP_SECRET=replace-with-a-different-stable-32-character-secret
WSS_OTP_MAC_SECRET=replace-with-a-development-fallback-only-32-character-secret

# Shared WSS thirdweb project for Kiwoom, JB and Namu. The client ID is public;
# the client secret stays in the BFF only. The server wallet address is reserved
# for future project-level operations and is never assigned to a customer wallet.
WSS_THIRDWEB_CLIENT_ID=
WSS_THIRDWEB_CLIENT_SECRET=
WSS_THIRDWEB_WALLET_ADDRESS=
VITE_WSS_WALLETCONNECT_PROJECT_ID=
# Optional complete per-tenant project overrides. Leave unset for the shared project.
WSS_THIRDWEB_KIWOOM_CLIENT_ID=
WSS_THIRDWEB_KIWOOM_SECRET_KEY=
WSS_THIRDWEB_JB_CLIENT_ID=
WSS_THIRDWEB_JB_SECRET_KEY=
WSS_THIRDWEB_NAMU_CLIENT_ID=
WSS_THIRDWEB_NAMU_SECRET_KEY=

# Supabase Auth Send SMS Hook + SOLAPI. Keep these server/Edge-only.
WSS_AUTH_SEND_SMS_HOOK_URI=https://your-wss-dev-project.supabase.co/functions/v1/wss-auth-send-sms
WSS_AUTH_SEND_SMS_HOOK_SECRET=v1,whsec_replace-with-generated-standard-webhook-secret
WSS_SOLAPI_API_KEY=replace-with-solapi-api-key
WSS_SOLAPI_API_SECRET=replace-with-solapi-api-secret
WSS_SOLAPI_SENDER_NUMBER=replace-with-registered-solapi-sender-number

# Phone escrow stays fail-closed unless execution, the claim surface, and an
# explicit production asset allowlist are configured. Never copy the signer private key here.
WSS_PHONE_ESCROW_EXECUTION_ENABLED=false
# Allowed IDs: canonical USDC on Ethereum, Polygon, Arbitrum, Base; native ETH
# on Ethereum, Arbitrum, Base; native POL on Polygon.
# Payout caps are enforced in code: 100 USDC, 0.1 ETH, or 100 POL per transfer.
WSS_PHONE_ESCROW_ALLOWED_ASSET_IDS=
WSS_PHONE_CLAIM_BASE_URL=https://took-wss.vercel.app/c
WSS_PHONE_ESCROW_CLAIM_SIGNER_ADDRESS=0xFe86A4f256eB3b2C303Fc2e8C9bC81f025B80387
WSS_PHONE_ESCROW_ETHEREUM_ADDRESS=0x9eA2344023224015bA530DF91910dD8bb131aD49
WSS_PHONE_ESCROW_POLYGON_ADDRESS=0x7482f2b8d5c85de8037145a6b0282be66163ae8a
WSS_PHONE_ESCROW_ARBITRUM_ADDRESS=0xbf28dBdABE2f08E736FBdeA33b74D925D3e8D573
WSS_PHONE_ESCROW_BASE_ADDRESS=0xA119D5128480B3084356ed665c2B936ee0032Ef3

# Shared took infrastructure. BFF-only: never expose these values to the WebView.
# Point these URLs at the already-operated wallet-price-quote and kyt-screen functions.
WSS_TOOK_PRICE_QUOTE_URL=https://your-infra-project.supabase.co/functions/v1/wallet-price-quote
WSS_CMC_API_KEY=
WSS_CMC_API_URL=https://pro-api.coinmarketcap.com
WSS_TOOK_KYT_URL=https://your-infra-project.supabase.co/functions/v1/kyt-screen
WSS_TOOK_PERMIT_RELAY_URL=https://your-infra-project.supabase.co/functions/v1/permit-relay
WSS_TOOK_INFRA_ANON_KEY=replace-with-shared-infra-publishable-key
# Took Pay direct USDC relay. Use Took Pay's own Supabase URL and public anon key;
# this is a separate provider from the WSS price/KYT project above.
WSS_TOOK_TRANSFER_RELAY_URL=https://your-took-pay-project.supabase.co/functions/v1/took-pay-transfer-relay
WSS_TOOK_TRANSFER_RELAY_ANON_KEY=replace-with-took-pay-publishable-key
WSS_TOOK_TRANSFER_STATUS_KEY=replace-with-shared-server-only-status-key
WSS_TOOK_PHONE_CLAIM_URL=https://your-took-pay-project.supabase.co/functions/v1/took-pay-wss-phone-claim
WSS_TOOK_PHONE_CLAIM_ANON_KEY=replace-with-took-pay-publishable-key
WSS_TOOK_PHONE_CLAIM_KEY=replace-with-shared-server-only-phone-claim-key
WSS_SOLANA_SPONSOR_ENABLED=false
WSS_TOOK_SOLANA_SPONSOR_URL=https://your-took-pay-project.supabase.co/functions/v1/took-pay-wss-solana-sponsor
WSS_TOOK_SOLANA_SPONSOR_KEY=replace-with-shared-server-only-solana-sponsor-key
# Uses WSS_TOOK_INFRA_ANON_KEY or WSS_TOOK_TRANSFER_RELAY_ANON_KEY if omitted.
WSS_TOOK_SOLANA_SPONSOR_ANON_KEY=

# Server-side DEX aggregation. The API key never enters the wallet WebView.
# Phase 1 uses 0x Swap API v2 AllowanceHolder for same-chain EVM exact-in/out.
WSS_ZEROX_API_KEY=
WSS_ZEROX_API_URL=https://api.0x.org

# When the WSS-owned Edge adapters are deployed, configure these as Edge secrets.
WSS_BONANZA_PRICES_URL=https://server-only-bonanza-gateway.example/prices
WSS_BONANZA_GATEWAY_TOKEN=replace-with-server-only-bonanza-token
WSS_TRANSIGHT_API_URL=https://server-only-transight-gateway.example
WSS_TRANSIGHT_API_KEY=replace-with-server-only-transight-key

# Optional chain RPC overrides. Public defaults are used only in local development.
WSS_ETHEREUM_RPC_URL=
WSS_POLYGON_RPC_URL=
WSS_ARBITRUM_RPC_URL=
WSS_BASE_RPC_URL=
WSS_BNB_RPC_URL=
WSS_SOLANA_RPC_URL=
WSS_BITCOIN_API_URL=
WSS_TRON_API_URL=
WSS_XRP_RPC_URL=
