# Local development only. Production must provide independently generated secrets.
WSS_SESSION_SECRET=replace-with-at-least-32-random-characters
WSS_SUBJECT_HASH_SECRET=replace-with-a-different-stable-32-character-secret
WSS_INSTITUTION_API_KEY=replace-with-an-institution-server-secret
WSS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
VITE_WSS_BFF_URL=http://localhost:4100
VITE_WSS_WALLET_URL=http://localhost:5174
VITE_WSS_ALLOWED_HOST_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_WSS_ALLOWED_BFF_ORIGINS=http://localhost:4100,http://127.0.0.1:4100

# Isolated WSS development database. Never point this at took/XLOT B2C or production.
SUPABASE_URL=https://your-wss-dev-project.supabase.co
SUPABASE_ANON_KEY=replace-with-wss-dev-publishable-key
DATABASE_URL=postgresql://server-only-wss-role:password@host:5432/postgres
