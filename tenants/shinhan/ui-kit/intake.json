{
  "schemaVersion": 1,
  "tenantId": "shinhan",
  "sources": {
    "roots": [".", "icons_transparent", "additional"],
    "exclude": ["extracted/**", "qa/**", ".artifacts/**"],
    "readOnly": true
  },
  "review": {
    "mode": "draft-without-intermediate-approval",
    "referenceViewport": { "widthCssPx": 360, "heightCssPx": 780, "status": "estimated" },
    "robustnessWidthsCssPx": [320, 360, 390, 430],
    "allowExternalUpload": false,
    "url": "http://127.0.0.1:5174/shinhan-review.html",
    "devCommand": ["npm", "run", "dev", "-w", "@took-wss/wallet-webview", "--", "--host", "127.0.0.1"]
  },
  "figma": { "enabled": false, "frames": [] },
  "fontOverrides": {
    "heading": "NanumSquare AC",
    "body": "NanumSquare AC",
    "numeral": "NanumSquare AC",
    "control": "NanumSquare AC"
  },
  "runtimeBindings": {
    "profileId": "shinhan-super-sol-preview-v1",
    "manifestPath": null,
    "presentationPath": "tenants/shinhan/presentation",
    "hostChromePath": "tenants/shinhan/host-chrome"
  }
}
